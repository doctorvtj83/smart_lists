# Neon Postgres connection URL — `dev` branch, pooled endpoint.
# The Neon project has three branches: `production` (live app, configured in Vercel only),
# `dev` (this file) and `test` (see .env.test.example). Never point this at `production`.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Auth.js
AUTH_SECRET="<generate with: npx auth secret>"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
